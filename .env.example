# コピーして .env を作る:  cp .env.example .env
# .env は Git に入れない・人に見せない・チャットや AI に貼らない（.gitignore で除外済み）。
# このファイル（.env.example）には、本物の値を書かない。項目の一覧だけを置く。
# 書き方: 「=」の前後に空白を入れない。行の途中に # コメントを書かない。

# ---- 動かし方 -------------------------------------------------------------
# development（開発）/ demo（発表用。架空のデータ）/ production（本番）
# 未設定だと production として動き、下の「demo・production で必須」が足りないと起動しない。
APP_ENV=development

# 作り方:  python3 -c "import secrets; print(secrets.token_hex(32))"
# development だけは空でも動く（開発専用の固定の値になる）。demo・production は空・短い値だと起動しない。
SECRET_KEY=

# ---- データベース -----------------------------------------------------------
# 開発は SQLite（instance/ の下にできる）。demo・production は MySQL（SQLite だと起動しない）。
DATABASE_URL=sqlite:///tsunagudake.sqlite
# MySQL の例（文字コードは utf8mb4。パスワードは英数字だけにすると URL の直しが要らない）:
# DATABASE_URL=mysql+pymysql://tsunagudake:パスワード@127.0.0.1:3306/tsunagudake?charset=utf8mb4
# MySQL で全テストを通すときの、テスト専用の DB（テストのたびに全テーブルを作って消す。本物のデータを入れない）:
# TEST_DATABASE_URL=mysql+pymysql://tsunagudake:パスワード@127.0.0.1:3306/tsunagudake_test?charset=utf8mb4

# ---- 規則の既定値（変えたいときだけ。03 詳細設計書 §5）-------------------------
# DEFAULT_HOURLY_RATE_YEN=4000
# DEFAULT_FEE_SHARE_BP=4000
# FEE_SHARE_MAX_BP=4999
# TRAVEL_LIMIT_MINUTES=60
# TRIAL_DAYS=30
# PLEDGE_VALID_DAYS=365
# REGION_K_ANONYMITY=5

# ---- 回数制限（既定のまま使える。変えたいときだけ）------------------------------
# RATE_LIMIT_ENABLED=1
# RATE_LOGIN_FAIL_MAX=5
# RATE_LOGIN_FAIL_SECONDS=900
# RATE_LOGIN_IP_MAX=20

# ---- demo・production で必須（development では不要）---------------------------
# BASE_URL=https://tsunagudake.example.jp
# TRUSTED_HOSTS=tsunagudake.example.jp
# PROXY_FIX=1
# SESSION_COOKIE_SECURE=1

# ---- demo だけ ---------------------------------------------------------------
# デモ用のアカウントの共通のパスワード（seed-demo が使う。スライドや README に書かない）
# DEMO_PASSWORD=

# ---- 運営者の表示（空なら「準備中」と出る。個人の連絡先はコードに書かず、ここで設定する）----
# OPERATOR_NAME=
# SUPPORT_EMAIL=

# ---- メール ---------------------------------------------------------------
# production の SMTP 設定は ~/.config/tsunagudake-mail/smtp.env に置く（runbook）。
# demo・development では運営画面に記録する。

# ---- AI（発表のあと。既定は使わない）-------------------------------------------
# off（使わない）/ fake（テスト用の偽物）/ claude（翻訳の候補だけ）
# AI_DRIVER=off
# ANTHROPIC_API_KEY=
# AI_MODEL=
# AI_MONTHLY_LIMIT_YEN=1000

AI_DRIVER=off
AI_MODEL=
AI_API_KEY=
AI_MONTHLY_LIMIT_YEN=0
AI_OFFICE_MONTHLY_LIMIT_YEN=0
AI_INPUT_YEN_PER_MTOK=0
AI_OUTPUT_YEN_PER_MTOK=0
